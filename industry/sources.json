      "name": "Hugging Face · DeepSeek 新模型",
      "kind": "json_list",
      "config": {
        "url": "https://huggingface.co/api/models?author=deepseek-ai&sort=createdAt&direction=-1&limit=20&expand[]=lastModified",
        "titlePaths": [
          "id"
        ],
        "externalIdPath": "id",
        "urlTemplate": "https://huggingface.co/{raw:id}",
        "ingestNoiseFilter": {
          "dropMarkersTitleOnly": [
            "-bf16",
            "-fp8",
            "-fp4",
            "-mxfp8",
